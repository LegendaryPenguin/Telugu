# Copy to `.env` and fill in. `npm start` loads it automatically (Node 18+ --env-file).
# Nothing here is committed; .env is gitignored.

# ── LLM (powers Talk + Add-phrase) ──────────────────────────────────────────
# Pick ONE provider.

# Option A — Google Gemini (RECOMMENDED to start: free tier, no card needed).
# Get a key at https://aistudio.google.com/apikey — the free tier's rate limits
# are plenty for personal daily practice. Gemini speaks the OpenAI protocol, so
# it just works here.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash       # fast + free; try gemini-2.5-flash for more quality

# Option B — Anthropic (Claude). Best quality; paid.
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5

# Option C — LOCAL model, fully offline & keyless (Ollama / LM Studio / llama.cpp).
# These expose an OpenAI-compatible server, so just point OPENAI_* at them.
# No key needed (leave OPENAI_API_KEY blank). Install Ollama, then:
#   ollama pull llama3.1        # or qwen2.5, gemma2, etc.
#   ollama serve                # serves on :11434
# Caveat: small local models are weaker at Telangana dialect than Gemini/Claude.
# LLM_PROVIDER=openai
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_MODEL=llama3.1
# OPENAI_API_KEY=               # leave blank for local

# Option D — any other OpenAI-compatible endpoint (OpenAI, Groq, Together,
# Sarvam chat, or 0G's decentralized router). Fill OPENAI_* as above.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
#
# 0G Compute router example (needs an account + deposit at pc.0g.ai):
# OPENAI_BASE_URL=https://router-api.0g.ai/v1
# OPENAI_MODEL=deepseek-chat        # or whatever the router lists

# ── Cloud TTS (optional upgrade from free browser voice) ────────────────────
# Leave TTS_PROVIDER=none to use the free in-browser Telugu voice.

# TTS_PROVIDER=sarvam               # Indic-specialized, cheap (₹100 free credits)
# SARVAM_API_KEY=
# SARVAM_TTS_MODEL=bulbul:v2
# SARVAM_SPEAKER=anushka

# TTS_PROVIDER=google               # highest quality neural (Chirp 3: HD)
# GOOGLE_TTS_KEY=
# GOOGLE_TTS_VOICE=te-IN-Chirp3-HD-Kore

PORT=8787
